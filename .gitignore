# Environment files: keep real secrets out of Git.
.env
.env.*
!.env.example
!.env.*.example

# Credentials, private keys, and certificates
*.pem
*.key
*.p12
*.pfx

# Dependencies and package-manager artifacts
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/
coverage/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local databases and container data
pgdata/
docker-volumes/
*.sqlite
*.sqlite3

# Terraform local state and working directory
.terraform/
*.tfstate
*.tfstate.*
