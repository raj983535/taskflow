# TaskFlow API Environment Configuration Example
# Copy this file to .env for local development overrides.
# Real secrets must NEVER be committed to Git.

# Server TCP Port (integer: 1 - 65535; default: 5000)
PORT=5000

# Environment mode: development | production | test
NODE_ENV=development

# Allowed Frontend Origin for CORS (scheme://host[:port] without path or query; default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
